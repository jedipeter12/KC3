# These values are public and are embedded in the Expo application bundle.
# Copy this file to .env.local and fill in the public values from Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/operator-only values. Supabase values are shared by
# the attended ingestion/detail/correction CLIs and Overture review staging;
# no Overture account or key is required. The Google key is
# used only by ingestion. Never prefix these with EXPO_PUBLIC_ or include real
# values in a committed file.
GOOGLE_PLACES_API_KEY=
KC3_SUPABASE_URL=
KC3_SUPABASE_SERVICE_ROLE_KEY=
